# FlowForge Environment Template
# Copy to .env and fill in your values

# Shared
JWT_SECRET=your-super-secret-jwt-key-min64-chars-long
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-min64-chars-long
OPENAI_API_KEY=sk-your-openai-api-key-here
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend specific
DATABASE_URL=postgresql://user:pass@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=AdminPass123!

