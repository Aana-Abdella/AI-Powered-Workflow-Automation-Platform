ENV=development
DATABASE_URL=postgresql+psycopg://flowforge:flowforge_password@localhost:5432/flowforge
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-super-secret-key-min-32-chars
JWT_REFRESH_SECRET=change-me-super-secret-refresh-key-32
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CORS_ORIGINS=http://localhost:3000
BACKEND_PUBLIC_URL=http://localhost:4000
FREE_PLAN_LIMIT=100
AUTH_RATE_LIMIT=10/minute
WEBHOOK_RATE_LIMIT=60/minute
API_RATE_LIMIT=120/minute
ADMIN_SEED_EMAIL=admin@flowforge.local
ADMIN_SEED_PASSWORD=Admin@12345
