# Backend Environment Variables
# Copy this file to .env and fill in your values

# Application
NODE_ENV=development
PORT=4000

# Database (PostgreSQL)
DATABASE_URL=postgresql://flowforge:flowforge_password@localhost:5432/flowforge

# Redis
REDIS_URL=redis://localhost:6379

# JWT Secrets (generate secure random strings for production)
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production

# OpenAI API Key (get from https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-your-openai-api-key

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# Admin Seed (optional)
ADMIN_SEED_EMAIL=admin@flowforge.local
ADMIN_SEED_PASSWORD=Admin@12345
ADMIN_SEED_ORG_NAME=Platform Admin
ADMIN_SEED_FIRST_NAME=Platform
ADMIN_SEED_LAST_NAME=Admin
